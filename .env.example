FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PORT=8081
API_PUBLIC_URL=http://localhost:8081
AI_PORT=8000
POSTGRES_DB=wamigos
POSTGRES_USER=wamigos
POSTGRES_PASSWORD=wamigos-local
AI_BASE_URL=http://ai-service:8000
AI_CONNECT_TIMEOUT=5s
AI_RESPONSE_TIMEOUT=25m
AI_HEALTH_TIMEOUT=3s
LOCAL_LLM_MODEL=qwen3:4b-instruct
OLLAMA_CONTEXT_LENGTH=16384
ENABLE_DEV_ENDPOINTS=false
ASR_MODEL=large-v3
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
DIARIZATION_MODEL=speechbrain/spkrec-ecapa-voxceleb
DIARIZATION_DEVICE=cuda
DIARIZATION_SIMILARITY_THRESHOLD=0.55
DIARIZATION_MAX_SPEAKERS=8
SPEECH_RELEASE_MODELS_AFTER_RUN=true
